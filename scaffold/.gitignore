# Keep .scratch versioned even when a global gitignore matches the name.
!.scratch/
!.scratch/**
.scratch/**/node_modules/

# Generated projections — the work graph, packets, anything .git-memory-scripts/ redirects
# here. Never committed: a projection is recomputed from the node headers on every
# read, so a committed copy can only ever be a second, staler answer.
build/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Node
node_modules/
